# 允许访问图片和安装包文件
Order Allow,Deny
Allow from all

# 允许访问图片类型和安装包(zip/exe)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|zip|exe|7z|rar)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# 禁止执行脚本
AddHandler cgi-script .php .php3 .php4 .php5 .php7 .phtml .jsp .asp .aspx .pl .py
RemoveHandler .php .php3 .php4 .php5 .php7 .phtml .jsp .asp .aspx .pl .py
